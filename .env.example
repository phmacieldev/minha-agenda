# Copie para .env.local (nunca commite .env.local — ele já está no .gitignore)
#
# Isto é SÓ para desenvolvimento local. O banco local (Docker) é completamente
# separado do banco de produção (Supabase) — não têm nenhuma comunicação entre
# si. Suba o banco local com `npm run db:up` antes de rodar a API.
#
# As variáveis de PRODUÇÃO vivem só no painel da Vercel (Settings →
# Environment Variables). Nunca copie a connection string de produção para
# nenhum arquivo deste repositório, nem local.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/minha_agenda
JWT_SECRET=troque-por-uma-string-aleatoria-longa

# URL que entra nos links do e-mail de confirmação (sem barra no final)
APP_URL=http://localhost:3000

# E-mail transacional (confirmação de cadastro) via Resend — resend.com.
# Sem RESEND_API_KEY, o app não trava: só registra no log que não enviou.
RESEND_API_KEY=
EMAIL_FROM=Minha Agenda <onboarding@resend.dev>

# Opcional: protege /api/cron/backup contra chamadas de fora da Vercel Cron.
# A própria Vercel Cron não precisa dele (identifica a chamada por um header
# interno); só importa se você quiser testar o endpoint manualmente com curl.
CRON_SECRET=

# Notificação push (resumo diário). Gere o par com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# A pública também precisa estar em index.html (const VAPID_PUBLIC_KEY=...).
# Sem essas duas, a notificação simplesmente não é enviada (não trava nada).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@minhaagenda.app
