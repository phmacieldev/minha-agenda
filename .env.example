# Copie para .env.local e preencha com os valores reais (nunca commitar .env.local)

# Connection string do Supabase: Project Settings > Database > Connection string > URI
# (use a porta "Transaction pooler" de 6543 se for rodar em serverless)
DATABASE_URL=postgres://postgres:SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Qualquer string longa e aleatória, só para assinar os tokens de login
JWT_SECRET=troque-por-uma-string-aleatoria-longa
