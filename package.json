{
  "name": "minha-agenda",
  "private": true,
  "version": "1.0.0",
  "description": "PWA de agenda de atendimentos + API TypeScript (Vercel functions) com Postgres no Supabase",
  "scripts": {
    "test": "playwright test",
    "dev:api": "node scripts/dev.js",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:restore-drill": "node scripts/restore-drill.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^3.2.24",
    "serve": "^14.2.5",
    "typescript": "^5.7.2",
    "vercel": "^64.7.0"
  }
}
